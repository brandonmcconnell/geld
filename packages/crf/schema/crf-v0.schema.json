{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.geld.sh/schema/crf-v0.schema.json",
  "title": "Common Review Format block",
  "oneOf": [
    {
      "$ref": "#/$defs/SummaryBlock"
    },
    {
      "$ref": "#/$defs/StatusBlock"
    },
    {
      "$ref": "#/$defs/RefusalBlock"
    },
    {
      "$ref": "#/$defs/FindingBlock"
    },
    {
      "$ref": "#/$defs/ReplyBlock"
    }
  ],
  "$defs": {
    "SummaryBlock": {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaTag"
        },
        "bot": {
          "$ref": "#/$defs/Bot"
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "kind": {
          "type": "string",
          "const": "summary"
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "result": {
          "$ref": "#/$defs/Result"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run"
      ]
    },
    "SchemaTag": {
      "type": "string",
      "const": "crf/v0"
    },
    "Bot": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "app": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "Links": {
      "type": "object",
      "properties": {
        "view": {
          "$ref": "#/$defs/UrlAction"
        },
        "rerun": {
          "$ref": "#/$defs/Action"
        },
        "fix": {
          "$ref": "#/$defs/Action"
        },
        "settings": {
          "$ref": "#/$defs/UrlAction"
        }
      }
    },
    "UrlAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "url"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    "Action": {
      "oneOf": [
        {
          "$ref": "#/$defs/UrlAction"
        },
        {
          "$ref": "#/$defs/CommentAction"
        }
      ]
    },
    "CommentAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "comment"
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "body"
      ]
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "superseded",
            "refused",
            "failed",
            "cancelled"
          ]
        },
        "headSha": {
          "$ref": "#/$defs/Sha"
        },
        "sequence": {
          "$ref": "#/$defs/PositiveInt"
        },
        "track": {
          "type": "string",
          "enum": [
            "code",
            "security"
          ]
        },
        "baseSha": {
          "$ref": "#/$defs/Sha"
        },
        "scope": {
          "type": "string",
          "enum": [
            "full",
            "incremental"
          ]
        },
        "coverage": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/Sha"
            },
            "to": {
              "$ref": "#/$defs/Sha"
            }
          },
          "required": [
            "to"
          ]
        },
        "part": {
          "type": "object",
          "properties": {
            "index": {
              "$ref": "#/$defs/PositiveInt"
            },
            "total": {
              "$ref": "#/$defs/PositiveInt"
            }
          },
          "required": [
            "index",
            "total"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        }
      },
      "required": [
        "id",
        "state",
        "headSha"
      ]
    },
    "Sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "PositiveInt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "Trigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "push",
            "comment",
            "check",
            "schedule",
            "manual",
            "api"
          ]
        },
        "commentId": {
          "$ref": "#/$defs/PositiveInt"
        },
        "by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type"
      ]
    },
    "Result": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "clean",
            "findings"
          ]
        },
        "score": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "value",
            "max"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "moderate",
            "high"
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "high": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "medium": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "low": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "info": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "resolvedSinceLast": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previouslyMissed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gate": {
          "type": "object",
          "properties": {
            "blocking": {
              "type": "boolean"
            },
            "threshold": {
              "$ref": "#/$defs/Severity"
            }
          },
          "required": [
            "blocking"
          ]
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "approve",
            "comment",
            "request_changes"
          ]
        }
      },
      "required": [
        "verdict"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "vendorSeverity": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "new",
            "persisting",
            "fixed",
            "withdrawn"
          ]
        },
        "rule": {
          "$ref": "#/$defs/Rule"
        },
        "commentId": {
          "$ref": "#/$defs/PositiveInt"
        },
        "links": {
          "type": "object",
          "properties": {
            "view": {
              "$ref": "#/$defs/UrlAction"
            },
            "fix": {
              "$ref": "#/$defs/Action"
            }
          }
        }
      },
      "required": [
        "id",
        "title",
        "severity"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "$ref": "#/$defs/PositiveInt"
        },
        "startLine": {
          "$ref": "#/$defs/PositiveInt"
        },
        "side": {
          "type": "string",
          "enum": [
            "LEFT",
            "RIGHT"
          ]
        }
      },
      "required": [
        "path"
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "repo",
            "bot"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source"
      ]
    },
    "StatusBlock": {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaTag"
        },
        "bot": {
          "$ref": "#/$defs/Bot"
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "kind": {
          "type": "string",
          "const": "status"
        },
        "run": {
          "$ref": "#/$defs/Run"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run"
      ]
    },
    "RefusalBlock": {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaTag"
        },
        "bot": {
          "$ref": "#/$defs/Bot"
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "kind": {
          "type": "string",
          "const": "refusal"
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "refusal": {
          "$ref": "#/$defs/Refusal"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run",
        "refusal"
      ]
    },
    "Refusal": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "disabled",
            "not_installed",
            "quota",
            "billing",
            "permissions",
            "too_large",
            "skipped_by_config",
            "other"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "FindingBlock": {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaTag"
        },
        "bot": {
          "$ref": "#/$defs/Bot"
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "kind": {
          "type": "string",
          "const": "finding"
        },
        "run": {
          "$ref": "#/$defs/RunRef"
        },
        "finding": {
          "$ref": "#/$defs/Finding"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run",
        "finding"
      ]
    },
    "RunRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ]
    },
    "ReplyBlock": {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/SchemaTag"
        },
        "bot": {
          "$ref": "#/$defs/Bot"
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "kind": {
          "type": "string",
          "const": "reply"
        },
        "run": {
          "$ref": "#/$defs/RunRef"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind"
      ]
    }
  }
}
