{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.geld.sh/schema/crf-v0.schema.json",
  "title": "Common Review Format block",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/__schema0"
        },
        "bot": {
          "$ref": "#/$defs/__schema1"
        },
        "links": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "type": "string",
          "const": "summary"
        },
        "run": {
          "$ref": "#/$defs/__schema7"
        },
        "result": {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "clean",
                "findings"
              ]
            },
            "score": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "value",
                "max"
              ]
            },
            "risk": {
              "type": "string",
              "enum": [
                "minimal",
                "low",
                "moderate",
                "high"
              ]
            },
            "counts": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/__schema11"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema12"
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "resolvedSinceLast": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "previouslyMissed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "gate": {
              "type": "object",
              "properties": {
                "blocking": {
                  "type": "boolean"
                },
                "threshold": {
                  "$ref": "#/$defs/__schema11"
                }
              },
              "required": [
                "blocking"
              ]
            },
            "recommendation": {
              "type": "string",
              "enum": [
                "approve",
                "comment",
                "request_changes"
              ]
            }
          },
          "required": [
            "verdict"
          ]
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/__schema0"
        },
        "bot": {
          "$ref": "#/$defs/__schema1"
        },
        "links": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "type": "string",
          "const": "status"
        },
        "run": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/__schema0"
        },
        "bot": {
          "$ref": "#/$defs/__schema1"
        },
        "links": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "type": "string",
          "const": "refusal"
        },
        "run": {
          "$ref": "#/$defs/__schema7"
        },
        "refusal": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "disabled",
                "not_installed",
                "quota",
                "billing",
                "permissions",
                "too_large",
                "skipped_by_config",
                "other"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run",
        "refusal"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/__schema0"
        },
        "bot": {
          "$ref": "#/$defs/__schema1"
        },
        "links": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "type": "string",
          "const": "finding"
        },
        "run": {
          "$ref": "#/$defs/__schema14"
        },
        "finding": {
          "$ref": "#/$defs/__schema12"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind",
        "run",
        "finding"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/__schema0"
        },
        "bot": {
          "$ref": "#/$defs/__schema1"
        },
        "links": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "type": "string",
          "const": "reply"
        },
        "run": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": [
        "schema",
        "bot",
        "kind"
      ]
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "crf/v0"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "app": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "view": {
          "$ref": "#/$defs/__schema3"
        },
        "rerun": {
          "$ref": "#/$defs/__schema5"
        },
        "fix": {
          "$ref": "#/$defs/__schema6"
        },
        "settings": {
          "$ref": "#/$defs/__schema4"
        }
      }
    },
    "__schema3": {
      "$ref": "#/$defs/__schema4"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "url"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    "__schema5": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "comment"
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "body"
          ]
        }
      ]
    },
    "__schema6": {
      "$ref": "#/$defs/__schema5"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema8"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "superseded",
            "refused",
            "failed",
            "cancelled"
          ]
        },
        "headSha": {
          "$ref": "#/$defs/__schema9"
        },
        "sequence": {
          "$ref": "#/$defs/__schema10"
        },
        "track": {
          "type": "string",
          "enum": [
            "code",
            "security"
          ]
        },
        "baseSha": {
          "$ref": "#/$defs/__schema9"
        },
        "scope": {
          "type": "string",
          "enum": [
            "full",
            "incremental"
          ]
        },
        "coverage": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/__schema9"
            },
            "to": {
              "$ref": "#/$defs/__schema9"
            }
          },
          "required": [
            "to"
          ]
        },
        "part": {
          "type": "object",
          "properties": {
            "index": {
              "$ref": "#/$defs/__schema10"
            },
            "total": {
              "$ref": "#/$defs/__schema10"
            }
          },
          "required": [
            "index",
            "total"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "trigger": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "push",
                "comment",
                "check",
                "schedule",
                "manual",
                "api"
              ]
            },
            "commentId": {
              "$ref": "#/$defs/__schema10"
            },
            "by": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "required": [
        "id",
        "state",
        "headSha"
      ]
    },
    "__schema8": {
      "type": "string",
      "minLength": 1
    },
    "__schema9": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "__schema10": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/__schema11"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/__schema13"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema13"
          }
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "vendorSeverity": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "new",
            "persisting",
            "fixed",
            "withdrawn"
          ]
        },
        "rule": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "repo",
                "bot"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source"
          ]
        },
        "commentId": {
          "$ref": "#/$defs/__schema10"
        },
        "links": {
          "type": "object",
          "properties": {
            "view": {
              "$ref": "#/$defs/__schema3"
            },
            "fix": {
              "$ref": "#/$defs/__schema6"
            }
          }
        }
      },
      "required": [
        "id",
        "title",
        "severity"
      ]
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "$ref": "#/$defs/__schema10"
        },
        "startLine": {
          "$ref": "#/$defs/__schema10"
        },
        "side": {
          "type": "string",
          "enum": [
            "LEFT",
            "RIGHT"
          ]
        }
      },
      "required": [
        "path"
      ]
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "id"
      ]
    }
  }
}
