# App origin and Better Auth session signing, required for real accounts
BETTER_AUTH_URL=<dashboard-origin>
BETTER_AUTH_SECRET=<random-secret-at-least-32-characters>
# Postgres application connection, Neon or a self-hosted compatible database
DATABASE_URL=<postgres-connection-string>
# Local demonstration only, rejected in hosted and production environments
GELD_DEMO_MODE=<true-or-false>
# Identity App, verified email and gist settings only
GITHUB_IDENTITY_CLIENT_ID=<identity-app-client-id>
GITHUB_IDENTITY_CLIENT_SECRET=<identity-app-client-secret>
GITHUB_IDENTITY_APP_ID=<identity-app-id>
GITHUB_IDENTITY_PRIVATE_KEY=<identity-app-pem>
# Separate repository App, scoped to enabled features
GITHUB_REPOSITORY_CLIENT_ID=<repository-app-client-id>
GITHUB_REPOSITORY_CLIENT_SECRET=<repository-app-client-secret>
GITHUB_REPOSITORY_APP_ID=<repository-app-id>
GITHUB_REPOSITORY_APP_SLUG=<repository-app-slug>
GITHUB_REPOSITORY_PRIVATE_KEY=<repository-app-pem>
GITHUB_WEBHOOK_SECRET=<webhook-signing-secret>
GITHUB_MANIFEST_STATE_SECRET=<manifest-state-signing-secret>
# Optional broad repository OAuth, never the default connection
GITHUB_OAUTH_CLIENT_ID=<optional-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<optional-oauth-client-secret>
# First-class provider sign-in
GITLAB_CLIENT_ID=<gitlab-client-id>
GITLAB_CLIENT_SECRET=<gitlab-client-secret>
BITBUCKET_CLIENT_ID=<bitbucket-client-id>
BITBUCKET_CLIENT_SECRET=<bitbucket-client-secret>
# Transactional delivery through the Resend adapter
EMAIL_API_KEY=<email-send-only-key>
EMAIL_FROM=<verified-sender>
# Encryption for user AI keys, tracker connections and customer credentials
TOKEN_ENCRYPTION_KEY=<random-encryption-secret>
# Stripe test mode only
STRIPE_SECRET_KEY=<stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-test-webhook-secret>
STRIPE_PRICE_STARTER=<starter-test-price-id>
STRIPE_PRICE_TEAM=<team-test-price-id>
STRIPE_PRICE_BUSINESS=<business-test-price-id>
# Geld-billed gateway and default planning model
AI_GATEWAY_API_KEY=<gateway-test-key>
AI_GATEWAY_BASE_URL=<gateway-https-origin>
AI_GATEWAY_MODEL=<planning-model-id>
# Optional measurement, loaded only after consent
NEXT_PUBLIC_POSTHOG_KEY=<posthog-project-key>
NEXT_PUBLIC_POSTHOG_HOST=<posthog-ingestion-origin>
# Server feature flags remain independent of measurement consent
POSTHOG_PERSONAL_API_KEY=<posthog-read-only-key>
POSTHOG_PROJECT_ID=<posthog-project-id>
GELD_FEATURE_FLAGS=<json-boolean-snapshot>
# Outbound Enterprise relay and job authentication
ENTERPRISE_RELAY_SECRET=<relay-signing-secret>
CRON_SECRET=<job-dispatch-secret>
# Tracker credentials are configured per connection, encrypted in the database
LINEAR_CLIENT_ID=<linear-read-only-client-id>
LINEAR_CLIENT_SECRET=<linear-client-secret>
JIRA_CLIENT_ID=<jira-read-only-client-id>
JIRA_CLIENT_SECRET=<jira-client-secret>
YOUTRACK_CLIENT_ID=<youtrack-client-id>
YOUTRACK_CLIENT_SECRET=<youtrack-client-secret>
ASANA_CLIENT_ID=<asana-client-id>
ASANA_CLIENT_SECRET=<asana-client-secret>
MONDAY_CLIENT_ID=<monday-client-id>
MONDAY_CLIENT_SECRET=<monday-client-secret>
# Optional customer Atlassian key for migrated Bitbucket workspaces
ATLASSIAN_ADMIN_API_KEY=<customer-admin-key>
