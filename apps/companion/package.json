{
  "name": "@geld/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {"geld-companion": "./dist/cli.mjs"},
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --external:@anthropic-ai/claude-agent-sdk --external:zod --outfile=dist/cli.mjs",
