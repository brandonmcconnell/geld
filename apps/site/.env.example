# Copy to .env.local (gitignored). These are only read by server code on geld.sh;
# the extension never sees them. Production/Preview values live in Vercel.

# GitHub OAuth App used for "Sign in with GitHub" on the site (web flow).
# Same Client ID as the extension's WXT_GITHUB_CLIENT_ID in production. For local
# development register a second OAuth App whose callback URL is
# http://localhost:3000/auth, because an OAuth App accepts exactly one callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Key that encrypts the session cookie. Any 32+ random bytes; use a different
# value per environment:  openssl rand -base64 32
# Rotating it only signs everyone out; settings live in their own gist.
AUTH_SECRET=
