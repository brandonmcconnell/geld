# Copy to .env.local (gitignored). These are only read by server code on geld.sh;
# the extension never sees them. Production values live in Vercel (Preview has
# none on purpose; Development can be pulled with `vercel env pull`).

# The Geld GitHub App, used for "Sign in with GitHub" on the site (web flow).
# Same Client ID as the extension's WXT_GELD_APP_CLIENT_ID. The App has both
# https://www.geld.sh/auth and http://localhost:3000/auth registered as callback
# URLs, so the same App works locally.
GELD_APP_CLIENT_ID=
GELD_APP_CLIENT_SECRET=

# The retired OAuth App, kept only while sign-ins it issued still exist: lets the
# site revoke those tokens when their owners reconnect through the App or sign
# out. Leave empty once the migration period is over.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Key that encrypts the session cookie. Any 32+ random bytes; use a different
# value per environment:  openssl rand -base64 32
# Rotating it only signs everyone out; settings live in their own gist.
AUTH_SECRET=
