# Public client id of the Geld GitHub App ("Enable Device Flow" ticked on the App).
# Used for "Sign in with GitHub" (settings sync). Users can override it in the options page.
# Same value as GELD_APP_CLIENT_ID on the site.
WXT_GELD_APP_CLIENT_ID=

# Public client id of the Geld Slack app (PKCE enabled, so no secret is needed anywhere).
# Used for Connect Slack under Connected services. See apps/site/integrations/slack/SUBMISSION.md.
WXT_GELD_SLACK_CLIENT_ID=

# Application (client) id of the Geld Entra app for Microsoft Teams. Its secret lives only on the site (MICROSOFT_CLIENT_SECRET).
# See apps/site/integrations/teams/SUBMISSION.md.
WXT_GELD_TEAMS_CLIENT_ID=
