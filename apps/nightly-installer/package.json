{
  "name": "geld-nightly",
  "version": "0.1.3",
  "description": "Installs Geld Nightly, the self-updating nightly build of the Geld browser extension, for the Chrome, Edge or Brave profiles you pick.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Brandon McConnell",
  "repository": { "type": "git", "url": "https://github.com/brandonmcconnell/geld", "directory": "apps/nightly-installer" },
  "bin": { "geld-nightly": "dist/geld-nightly.mjs" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node build.mjs",
    "check": "tsc --noEmit && vitest run && node build.mjs"
  },
  "devDependencies": {
    "@geld/core": "workspace:*",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
