POSTGRES_PASSWORD=<generate-a-database-password>
RELAY_DATABASE_PASSWORD=<generate-a-separate-relay-password>
BETTER_AUTH_URL=https://geld.example.com
BETTER_AUTH_SECRET=<generate-at-least-32-random-characters>
TOKEN_ENCRYPTION_KEY=<generate-at-least-32-random-characters>
CRON_SECRET=<generate-a-private-worker-secret>
# Optional public HTTPS broker origin for downloaded connector configurations.
RELAY_PUBLIC_BROKER_URL=
# Optional legacy static channels. New pairings use encrypted database channels.
RELAY_CHANNELS=[]
