{
  "name": "geld-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @geld/extension dev",
    "build": "pnpm --filter @geld/extension build",
    "build:chrome": "pnpm --filter @geld/extension build:chrome",
    "build:firefox": "pnpm --filter @geld/extension build:firefox",
    "build:edge": "pnpm --filter @geld/extension build:edge",
    "build:safari": "pnpm --filter @geld/extension build:safari",
    "build:all": "pnpm --filter @geld/extension build:all",
    "zip:chrome": "pnpm --filter @geld/extension zip:chrome",
    "zip:firefox": "pnpm --filter @geld/extension zip:firefox",
    "zip:edge": "pnpm --filter @geld/extension zip:edge",
    "zip:safari": "pnpm --filter @geld/extension zip:safari",
    "zip:all": "pnpm --filter @geld/extension zip:all",
    "safari:project": "pnpm --filter @geld/extension safari:project",
    "safari:sync": "pnpm --filter @geld/extension safari:sync",
    "safari:open": "pnpm --filter @geld/extension safari:open",
    "dev:site": "pnpm --filter @geld/site dev",
    "build:site": "pnpm --filter @geld/site build",
    "catalog:build": "tsx scripts/catalog-build.ts",
    "catalog:check": "tsx scripts/catalog-build.ts --check",
    "catalog:sign": "node scripts/catalog-sign.mjs",
    "catalog:keygen": "node scripts/catalog-keygen.mjs",
    "check": "pnpm -r run check && pnpm catalog:check && pnpm docs:lines:check && pnpm test:scripts",
    "docs:lines": "tsx scripts/doc-lines.ts",
    "docs:lines:check": "tsx scripts/doc-lines.ts --check",
    "test": "pnpm -r run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/cla.test.mjs scripts/browser-e2e-selection.test.mjs apps/extension/scripts/comment-body-branding.test.mjs apps/extension/scripts/reference-index.test.mjs apps/extension/scripts/native-list-row.test.mjs apps/extension/scripts/bitbucket-cold-chip.test.mjs apps/extension/scripts/bitbucket-shell-acceptance.test.mjs apps/extension/scripts/bitbucket-syntax-on.test.mjs apps/extension/scripts/bitbucket-initial-native-on.test.mjs apps/extension/scripts/bitbucket-initial-on-source.test.mjs apps/extension/scripts/native-settings-readiness.test.mjs apps/extension/scripts/bitbucket-native-settings-diagnostic.test.mjs apps/extension/scripts/bitbucket-native-file-menu.test.mjs apps/extension/scripts/bitbucket-pipeline-visit.test.mjs apps/extension/scripts/bitbucket-pipeline-consent.test.mjs apps/extension/scripts/bitbucket-pipeline-main-asset.test.mjs apps/extension/scripts/bitbucket-main-asset-module-worker.test.mjs apps/extension/scripts/bitbucket-commit-oracle.test.mjs apps/extension/scripts/bitbucket-commit-links.test.mjs apps/extension/scripts/item-copy-acceptance.test.mjs apps/extension/scripts/greptile-command-acceptance.test.mjs apps/extension/scripts/bitbucket-local-reviewed.test.mjs apps/extension/scripts/bitbucket-hidden-authors.test.mjs apps/extension/scripts/round-attention-acceptance.test.mjs apps/extension/scripts/three-provider-settings.test.mjs apps/extension/scripts/bitbucket-native-bash.test.mjs apps/extension/scripts/bitbucket-native-bash-on.test.mjs apps/extension/scripts/gitlab-coderabbit-acceptance.test.mjs apps/extension/scripts/gitlab-file-search.test.mjs apps/extension/scripts/gitlab-whitespace-viewed.test.mjs apps/extension/scripts/gitlab-whitespace-session.test.mjs apps/extension/scripts/gitlab-shell-acceptance.test.mjs apps/extension/scripts/gitlab-displayed-outline.test.mjs apps/extension/scripts/gitlab-whole-test-context.test.mjs apps/extension/scripts/gitlab-standalone-whole.test.mjs apps/extension/scripts/gitlab-whole-focus-trace.test.mjs apps/extension/scripts/gitlab-comparison-observer.test.mjs apps/extension/scripts/bitbucket-syntax-settings.test.mjs apps/extension/scripts/gitlab-rendered-notes-acceptance.test.mjs apps/extension/scripts/gitlab-author-reuse-acceptance.test.mjs apps/extension/scripts/gitlab-table-height-acceptance.test.mjs scripts/provider-image-context.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "dev:dashboard": "pnpm --filter @geld/dashboard dev",
    "build:dashboard": "pnpm --filter @geld/dashboard build"
  },
  "devDependencies": {
    "@geld/core": "workspace:*",
    "tsx": "^4.23.13"
  }
}
