{
  "name": "geld-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @geld/extension dev",
    "build": "pnpm --filter @geld/extension build",
    "build:all": "pnpm --filter @geld/extension build:all",
    "zip:all": "pnpm --filter @geld/extension zip:all",
    "safari:project": "pnpm --filter @geld/extension safari:project",
    "safari:sync": "pnpm --filter @geld/extension safari:sync",
    "safari:open": "pnpm --filter @geld/extension safari:open",
    "dev:site": "pnpm --filter @geld/site dev",
    "build:site": "pnpm --filter @geld/site build",
    "catalog:build": "tsx scripts/catalog-build.ts",
    "catalog:check": "tsx scripts/catalog-build.ts --check",
    "catalog:sign": "node scripts/catalog-sign.mjs",
    "catalog:keygen": "node scripts/catalog-keygen.mjs",
    "check": "pnpm -r run check && pnpm catalog:check && pnpm docs:lines:check && pnpm test:scripts",
    "docs:lines": "tsx scripts/doc-lines.ts",
    "docs:lines:check": "tsx scripts/doc-lines.ts --check",
    "test": "pnpm -r run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/cla.test.mjs scripts/browser-e2e-selection.test.mjs apps/extension/scripts/comment-body-branding.test.mjs apps/extension/scripts/reference-index.test.mjs apps/extension/scripts/native-list-row.test.mjs apps/extension/scripts/bitbucket-cold-chip.test.mjs apps/extension/scripts/bitbucket-shell-acceptance.test.mjs apps/extension/scripts/bitbucket-commit-oracle.test.mjs apps/extension/scripts/bitbucket-commit-links.test.mjs apps/extension/scripts/item-copy-acceptance.test.mjs apps/extension/scripts/bitbucket-hidden-authors.test.mjs apps/extension/scripts/round-attention-acceptance.test.mjs apps/extension/scripts/three-provider-settings.test.mjs apps/extension/scripts/bitbucket-native-bash.test.mjs apps/extension/scripts/gitlab-coderabbit-acceptance.test.mjs apps/extension/scripts/gitlab-file-search.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@geld/core": "workspace:*",
    "tsx": "^4.23.13"
  }
}
