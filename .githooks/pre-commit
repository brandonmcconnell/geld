#!/bin/sh
# AGENTS.md and .cursor/BUGBOT.md are kept one sentence per line (scripts/doc-lines.ts), and CI fails otherwise.
files=$(git diff --cached --name-only --diff-filter=ACM -- AGENTS.md .cursor/BUGBOT.md)
[ -z "$files" ] && exit 0

tsx="$(git rev-parse --show-toplevel)/node_modules/.bin/tsx"
if [ ! -x "$tsx" ]; then
  echo "pre-commit: dependencies not installed, so AGENTS.md was not checked. Run \`pnpm docs:lines\` before pushing." >&2
  exit 0
fi

for file in $files; do
  if git diff --quiet -- "$file"; then
    "$tsx" scripts/doc-lines.ts "$file" || exit 1
    git add -- "$file"
  # Unstaged edits too: check the staged copy, since rewriting and re-staging the file would commit the parts left out.
  elif ! git show ":$file" | "$tsx" scripts/doc-lines.ts --stdin "$file"; then
    echo "pre-commit: $file has unstaged edits, so it was checked but not rewritten. Run \`pnpm docs:lines\` and stage the result." >&2
    exit 1
  fi
done
